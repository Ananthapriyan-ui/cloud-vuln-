# CloudVuln Backend Environment Configuration — Example
# ======================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env (with real keys) to version control.

# ── App ───────────────────────────────────────────────────────────
APP_ENV=production
PROJECT_NAME=CloudVuln Security Engine
LOG_LEVEL=INFO

# ── JWT Security Keys ─────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-64-character-secret-key-in-production
REFRESH_SECRET_KEY=change-this-to-a-secure-random-64-character-refresh-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS Origins ─────────────────────────────────────────────────
# Comma-separated list or JSON array of allowed frontend origins
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Supabase PostgreSQL (PRIMARY DATABASE — REQUIRED) ────────────
# Get from: Supabase Dashboard → Project → Settings → Database → Connection string
# Use the "Transaction pooler" URI (port 6543) for production / serverless
# Use the "Session pooler" URI (port 5432) for local dev / long-lived connections
# Format: postgresql://postgres.[ref]:[password]@[host]:[port]/postgres
DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-db-password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Supabase Storage (for report file uploads — optional) ────────
# Get from: Supabase Dashboard → Project → Settings → API
# Required only if you want report files stored in Supabase Storage
SUPABASE_URL=https://[your-project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[your-service-role-key]
SUPABASE_STORAGE_BUCKET=reports

# ── NVD API (optional, for CVE lookups) ─────────────────────────
# Get from: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
