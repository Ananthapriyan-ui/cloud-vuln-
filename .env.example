# CloudVuln Frontend Environment Variables — Example
# ====================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local with real keys to version control.

# ── Supabase (Required for Google OAuth) ──────────────────────────
# Get from: Supabase Dashboard → Project → Settings → API
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ── Google OAuth via Supabase Configuration ───────────────────────
# 1. In Google Cloud Console: Create OAuth 2.0 Web Client ID
#    - Authorized Redirect URI: https://<your-project-ref>.supabase.co/auth/v1/callback
# 2. In Supabase Dashboard → Authentication → Providers → Google:
#    - Enable Google provider and paste your Client ID & Client Secret
# 3. In Supabase Dashboard → Authentication → URL Configuration:
#    - Set Site URL (e.g. http://localhost:5173 or https://yourdomain.com)

# ── Python Backend URL (FastAPI on Render) ─────────────────────────
# Set to your deployed Render API backend URL:
# VITE_API_URL=https://cloudvuln-api.onrender.com/api
# Leave empty (or unset) when using Vercel rewrites to proxy /api directly.
